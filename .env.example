# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5-mini

# Leave empty for OpenAI (Responses API). Setting it switches to the Chat Completions API,
# which other OpenAI-compatible endpoints offer. For Gemini's endpoint use:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=

# Optional: reasoning effort for gpt-5 models: minimal, low, medium or high (default low).
# LLM_REASONING_EFFORT=low

# Optional: USD per million tokens, used only for the cost estimate.
# Built-in prices cover a few common models; set these for any other model.
# LLM_PRICE_IN_PER_M=0.25
# LLM_PRICE_OUT_PER_M=2.00

# Optional: needs_review is set when a required field scores below this.
# REVIEW_THRESHOLD=0.7
